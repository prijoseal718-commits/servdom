    document.getElementById('gPersonal').textContent=cargarLista('servdom_personal').length;
    document.getElementById('gClientes').textContent=cargarLista('servdom_clientes').length;
    document.getElementById('gServicios').textContent=cargarLista('servdom_servicios').length;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ServDom</title>
    <style>
        *{margin:0; padding:0; box-sizing:border-box; font-family:sans-serif;}
        :root{
            --fondo:#0F172A;
            --capa:#1E293B;
            --dorado:#F59E0B;
            --texto:#F1F5F9;
            --texto2:#CBD5E1;
            --campo-fondo:#E2E8F0;
            --campo-texto:#000000;
            --verde:#10B981;
            --rojo:#EF4444;
        }
        body{background:var(--fondo); color:var(--texto); min-height:100vh; padding:16px;}
        .saludo{padding:12px; color:var(--dorado); font-size:17px; margin-bottom:16px; border-bottom:1px solid rgba(96,165,250,0.3);}
        .menu{display:flex; flex-direction:column; gap:10px; max-width:500px; margin:0 auto;}
        .menu button{background:linear-gradient(135deg,#1E293B,#334155); color:var(--texto); border:none; padding:16px; border-radius:12px; font-size:16px; text-align:left; cursor:pointer; border-left:3px solid transparent;}
        .menu button:hover{border-left-color:var(--dorado);}
        .menu button.rojo{background:linear-gradient(135deg,#7F1D1D,#991B1B); margin-top:20px;}
        .pantalla{display:none; max-width:500px; margin:0 auto;}
        .pantalla.activa{display:block; animation:aparecer 0.25s ease;}
        @keyframes aparecer{from{opacity:0; transform:translateY(10px);} to{opacity:1; transform:translateY(0);}}
        .volver{background:#475569; color:#fff; border:none; padding:10px 16px; border-radius:10px; margin-bottom:16px; cursor:pointer;}
        h2{color:var(--dorado); margin-bottom:16px; font-size:19px;}
        .tarjeta{background:var(--capa); border-radius:14px; padding:16px; margin-bottom:12px; border:1px solid rgba(96,165,250,0.25);}
        input,select,textarea{width:100%; padding:14px; margin:6px 0; background:var(--campo-fondo); color:var(--campo-texto); border:none; border-radius:10px; font-size:15px; outline:none;}
        input:focus,select:focus{box-shadow:0 0 0 2px var(--dorado);}
        .btn{width:100%; padding:14px; border:none; border-radius:10px; font-size:15px; cursor:pointer; margin-top:8px;}
        .btn.dorado{background:linear-gradient(135deg,#B7921F,#F59E0B); color:#000;}
        .btn.verde{background:linear-gradient(135deg,#059669,#10B981); color:#fff;}
        .btn.wsp{background:linear-gradient(135deg,#25D366,#128C7E); color:#fff;}
        .fila{display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid rgba(96,165,250,0.15); font-size:14px; align-items:center;}
        .fila:last-child{border-bottom:none;}
        .etiqueta{color:var(--texto2);}
        .oculto{display:none !important;}
        .registro{max-width:420px; margin:40px auto; text-align:center;}
        .logo{font-size:42px; color:var(--dorado); margin-bottom:10px; font-weight:bold;}
        hr{border:none; border-bottom:1px solid rgba(96,165,250,0.2); margin:16px 0;}
        .alerta{padding:10px; border-radius:8px; margin:8px 0;}
        .alerta.dorado{background:rgba(245,158,11,0.1); color:#FCD34D;}
    </style>
</head>
<body>

<!-- PANTALLA DE REGISTRO / INGRESO -->
<div id="pantallaRegistro">
    <div class="registro">
        <div class="logo">ServDom</div>
        <h2>Ingreso</h2>
        <input type="text" id="nombreReg" placeholder="Nombre completo">
        <input type="email" id="correoReg" placeholder="Correo electrónico">
        <input type="password" id="passReg" placeholder="Contraseña">
        <input type="password" id="passReg2" placeholder="Repetir contraseña">
        <button class="btn dorado" onclick="registrarse()">✅ Entrar / Registrarse</button>
    </div>
</div>

<!-- MENÚ PRINCIPAL -->
<div id="pantallaMenu" class="oculto">
    <div class="saludo" id="saludo"></div>
    <div class="menu">
        <button onclick="abrir('inicio')">📋 INICIO</button>
        <button onclick="abrir('personal')">👤 PERSONAL</button>
        <button onclick="abrir('clientes')">🏠 CLIENTES</button>
        <button onclick="abrir('calendario')">📅 CALENDARIO</button>
        <button onclick="abrir('stock')">📦 STOCK</button>
        <button onclick="abrir('sueldos')">💰 SUELDOS</button>
        <button onclick="abrir('pagos')">💳 PAGOS Y TARJETAS</button>
        <button onclick="abrir('graficas')">📊 GRÁFICAS</button>
        <button class="rojo" onclick="cerrarSesion()">🚪 Cerrar Sesión</button>
    </div>
</div>

<!-- PANTALLA PERSONAL -->
<div id="personal" class="pantalla">
    <button class="volver" onclick="volver()">← Volver</button>
    <h2>👤 Agregar Empleado</h2>
    <div class="tarjeta">
        <input type="text" id="empNombre" placeholder="Nombre completo">
        <input type="number" id="empEdad" placeholder="Edad">
        <input type="tel" id="empTel" placeholder="Teléfono">
        <input type="text" id="empCertEnf" placeholder="Certificado de enfermedad">
        <input type="text" id="empCertSalud" placeholder="Certificado de salud">
        <input type="date" id="empIngreso">
        <input type="date" id="empEgreso" placeholder="Fecha de egreso">
        <button class="btn dorado" onclick="agregarEmpleado()">✅ Guardar</button>
    </div>
    <div id="listaPersonal"></div>
</div>

<!-- PANTALLA CLIENTES -->
<div id="clientes" class="pantalla">
    <button class="volver" onclick="volver()">← Volver</button>
    <h2>🏠 Agregar Cliente</h2>
    <div class="tarjeta">
        <input type="text" id="cliNombre" placeholder="Nombre / Familia">
        <input type="text" id="cliDir" placeholder="Dirección">
        <input type="tel" id="cliTel" placeholder="Teléfono">
        <input type="text" id="cliTareas" placeholder="Tareas a realizar">
        <input type="text" id="cliHorario" placeholder="Horarios acordados">
        <button class="btn dorado" onclick="agregarCliente()">✅ Guardar</button>
    </div>
    <div id="listaClientes"></div>
</div>

<!-- PANTALLA CALENDARIO -->
<div id="calendario" class="pantalla">
    <button class="volver" onclick="volver()">← Volver</button>
    <h2>📅 Asignar Servicio</h2>
    <div class="tarjeta">
        <input type="date" id="servFecha">
        <input type="time" id="servHora">
        <input type="text" id="servCliente" placeholder="Cliente y Dirección">
        <input type="text" id="servEmpleado" placeholder="Empleado Asignado">
        <input type="text" id="servTarea" placeholder="Tarea a realizar">
        <button class="btn dorado" onclick="agregarServicio()">✅ Guardar</button>
    </div>
    <div id="listaServicios"></div>
</div>

<!-- PANTALLA INICIO -->
<div id="inicio" class="pantalla">
    <button class="volver" onclick="volver()">← Volver</button>
    <h2>📋 Servicios Activos</h2>
    <div id="listaInicio"></div>
</div>

<!-- PANTALLA STOCK -->
<div id="stock" class="pantalla">
    <button class="volver" onclick="volver()">← Volver</button>
    <h2>📦 Agregar Insumo</h2>
    <div class="tarjeta">
        <input type="text" id="prodNombre" placeholder="Nombre del insumo">
        <input type="number" id="prodCant" placeholder="Cantidad actual">
        <input type="number" id="prodMin" placeholder="Cantidad mínima">
        <button class="btn dorado" onclick="agregarProducto()">✅ Guardar</button>
    </div>
    <div id="listaProductos"></div>
</div>

<!-- PANTALLA SUELDOS -->
<div id="sueldos" class="pantalla">
    <button class="volver" onclick="volver()">← Volver</button>
    <h2>💰 Calcular Sueldo</h2>
    <div class="tarjeta">
        <input type="text" id="liqEmpleado" placeholder="Nombre del Empleado">
        <input type="number" id="liqHoras" placeholder="Horas trabajadas">
        <input type="number" id="liqAdelanto" placeholder="Adelantos $">
        <button class="btn dorado" onclick="calcularSueldo()">🧾 Calcular</button>
        <div id="resSueldo" style="margin-top:12px;"></div>
    </div>
</div>

<!-- PANTALLA PAGOS Y TARJETAS ✅ COMPLETA -->
<div id="pagos" class="pantalla">
    <button class="volver" onclick="volver()">← Volver</button>
    <h2>💳 Pagos y Tarjetas</h2>

    <!-- TARJETAS -->
    <div class="tarjeta">
        <h3 style="color:var(--dorado); margin-bottom:12px;">Mis Tarjetas</h3>
        <input type="text" id="tarTitular" placeholder="Nombre del titular">
        <input type="text" id="tarNum" placeholder="Número de tarjeta">
        <input type="text" id="tarVenc" placeholder="Vencimiento (MM/AA)">
        <select id="tarTipo">
            <option value="debito">Tarjeta de Débito</option>
            <option value="credito">Tarjeta de Crédito</option>
        </select>
        <button class="btn dorado" onclick="guardarTarjeta()">💳 Guardar Tarjeta</button>
    </div>
    <div id="listaTarjetas"></div>

    <!-- CONTACTOS FRECUENTES ✅ -->
    <div class="tarjeta">
        <h3 style="color:var(--dorado); margin-bottom:12px;">Contactos Frecuentes</h3>
        <input type="text" id="contactoNombre" placeholder="Nombre / Apodo">
        <input type="text" id="contactoDato" placeholder="CBU / Alias / Teléfono">
        <button class="btn" onclick="guardarContacto()">💾 Guardar Contacto</button>
        <div id="listaContactos"></div>
    </div>

    <!-- REALIZAR TRANSFERENCIA ✅ -->
    <div class="tarjeta">
        <h3 style="color:var(--dorado); margin-bottom:12px;">Realizar Transferencia</h3>
        <select id="pagoContacto" onchange="cargarContacto()">
            <option value="">Seleccionar contacto guardado</option>
        </select>
        <input type="text" id="pagoDestino" placeholder="Destinatario / CBU / Alias">
        <input type="number" id="pagoMonto" placeholder="Monto a transferir $" step="0.01">
        <input type="text" id="pagoConcepto" placeholder="Concepto">
        <select id="pagoTarjeta">
            <option value="">Pagar desde...</option>
        </select>
        <input type="date" id="pagoFecha">
        <label style="color:var(--texto2); font-size:14px;"><input type="checkbox" id="pagoAgendar"> Agendar pago</label>
        <button class="btn verde" onclick="realizarPago()">✅ Confirmar Transferencia</button>
    </div>

    <!-- RECIBIR PAGOS ✅ -->
    <div class="tarjeta">
        <h3 style="color:var(--dorado); margin-bottom:12px;">Recibir Pagos</h3>
        <textarea id="datosRecibir" rows="3" placeholder="Escribí tus datos para que te transfieran:&#10;CBU / Alias / Banco"></textarea>
        <button class="btn" onclick="copiarDatos()">📋 Copiar mis datos</button>
        <button class="btn wsp" onclick="compartirPorWhatsApp()">💬 Compartir por WhatsApp</button>
    </div>

    <!-- HISTORIAL Y COMPROBANTES ✅ -->
    <div class="tarjeta">
        <h3 style="color:var(--dorado); margin-bottom:12px;">Historial de Movimientos</h3>
        <p class="fila"><span class="etiqueta">💰 Total Entrante:</span><span style="color:var(--verde);" id="totalEntrante">$0.00</span></p>
        <p class="fila"><span class="etiqueta">💸 Total Saliente:</span><span style="color:var(--rojo);" id="totalSaliente">$0.00</span></p>
        <p class="fila" style="border-top:2px solid var(--dorado); padding-top:12px; margin-top:8px; font-weight:bold;">
            <span style="color:var(--dorado);">💵 Saldo:</span>
            <span style="color:var(--dorado); font-size:18px;" id="saldoNeto">$0.00</span>
        </p>
        <hr>
        <div id="listaPagos"></div>
    </div>
</div>

<!-- PANTALLA GRÁFICAS -->
<div id="graficas" class="pantalla">
    <button class="volver" onclick="volver()">← Volver</button>
    <h2>📊 Resumen</h2>
    <div class="tarjeta">
        <p class="fila"><span class="etiqueta">👥 Personal activo:</span><span id="gPersonal">0</span></p>
        <p class="fila"><span class="etiqueta">🏠 Clientes registrados:</span><span id="gClientes">0</span></p>
        <p class="fila"><span class="etiqueta">📝 Servicios asignados:</span><span id="gServicios">0</span></p>
    </div>
</div>

<script>
let usuarioActivo = null;

window.onload = function(){
    let u = localStorage.getItem('servdom_usuario');
    if(u){ usuarioActivo = JSON.parse(u); mostrarMenu(); }
};

function registrarse(){
    let n = document.getElementById('nombreReg').value.trim();
    let c = document.getElementById('correoReg').value.trim();
    let p1 = document.getElementById('passReg').value;
    let p2 = document.getElementById('passReg2').value;
    if(!n || !c || !p1) return alert('Completa todos los campos');
    if(p1 !== p2) return alert('Las contraseñas no coinciden');

    let hayAdmin = localStorage.getItem('servdom_hayAdmin');
    let rol = hayAdmin ? 'empleado' : 'admin';
    if(!hayAdmin) localStorage.setItem('servdom_hayAdmin', 'SI');

    localStorage.setItem('servdom_usuario', JSON.stringify({nombre:n, correo:c, rol:rol}));
    alert(`¡Bienvenido ${n}! Tu rol: ${rol.toUpperCase()}`);
    mostrarMenu();
}

function mostrarMenu(){
    document.getElementById('pantallaRegistro').classList.add('oculto');
    document.getElementById('pantallaMenu').classList.remove('oculto');
    let h = new Date().getHours();
    let saludo = h<12 ? '¡Buenos días' : h<19 ? '¡Buenas tardes' : '¡Buenas noches';
    let rolTexto = usuarioActivo.rol==='admin' ? '🔑 Administrador' : '👤 Empleado';
    document.getElementById('saludo').textContent = `${saludo}, ${usuarioActivo.nombre}! — ${rolTexto}`;
    actualizarGraficas();
}

function abrir(nombre){
    document.querySelectorAll('.pantalla').forEach(p=>p.classList.remove('activa'));
    document.getElementById('pantallaMenu').classList.add('oculto');
    document.getElementById(nombre).classList.add('activa');
    if(nombre==='inicio') cargarInicio();
    if(nombre==='personal') cargarPersonal();
    if(nombre==='clientes') cargarClientes();
    if(nombre==='calendario') cargarServicios();
    if(nombre==='stock') cargarStock();
    if(nombre==='pagos'){ cargarTarjetasSelect(); cargarContactosSelect(); calcularTotalesPagos(); cargarPagos(); }
}

function volver(){
    document.querySelectorAll('.pantalla').forEach(p=>p.classList.remove('activa'));
    document.getElementById('pantallaMenu').classList.remove('oculto');
    actualizarGraficas();
}

function cerrarSesion(){ localStorage.removeItem('servdom_usuario'); location.reload(); }
function guardarLista(clave,item){let l=JSON.parse(localStorage.getItem(clave)||'[]'); l.push(item); localStorage.setItem(clave,JSON.stringify(l));}
function cargarLista(clave){return JSON.parse(localStorage.getItem(clave)||'[]');}

// PERSONAL
function agregarEmpleado(){
    let e={id:Date.now(), nombre:document.getElementById('empNombre').value, edad:document.getElementById('empEdad').value, tel:document.getElementById('empTel').value, certEnf:document.getElementById('empCertEnf').value, certSalud:document.getElementById('empCertSalud').value, ingreso:document.getElementById('empIngreso').value, egreso:document.getElementById('empEgreso').value||'Activo'};
    if(!e.nombre) return alert('Escribe el nombre del empleado');
    guardarLista('servdom_personal',e); alert('✅ Empleado guardado');
    document.getElementById('empNombre').value=''; document.getElementById('empEdad').value=''; document.getElementById('empTel').value=''; document.getElementById('empCertEnf').value=''; document.getElementById('empCertSalud').value=''; document.getElementById('empIngreso').value=''; document.getElementById('empEgreso').value='';
    cargarPersonal(); actualizarGraficas();
}
function cargarPersonal(){
    let l=cargarLista('servdom_personal');
    document.getElementById('listaPersonal').innerHTML=l.length?l.map(e=>`<div class="tarjeta"><h3 style="color:var(--dorado);">${e.nombre}</h3><p class="fila"><span class="etiqueta">Edad:</span><span>${e.edad}</span></p><p class="fila"><span class="etiqueta">Teléfono:</span><span>${e.tel}</span></p><p class="fila"><span class="etiqueta">Cert. Enfermedad:</span><span>${e.certEnf||'Sin registro'}</span></p><p class="fila"><span class="etiqueta">Cert. Salud:</span><span>${e.certSalud||'Sin registro'}</span></p><p class="fila"><span class="etiqueta">Ingreso:</span><span>${e.ingreso}</span></p><p class="fila"><span class="etiqueta">Egreso:</span><span>${e.egreso}</span></p></div>`).join(''):'<p style="text-align:center; color:var(--texto2); padding:16px;">Sin empleados registrados</p>';
}

// CLIENTES
function agregarCliente(){
    let c={id:Date.now(), nombre:document.getElementById('cliNombre').value, dir:document.getElementById('cliDir').value, tel:document.getElementById('cliTel').value, tareas:document.getElementById('cliTareas').value, horario:document.getElementById('cliHorario').value};
    if(!c.nombre) return alert('Escribe el nombre del cliente');
    guardarLista('servdom_clientes',c); alert('✅ Cliente guardado');
    document.getElementById('cliNombre').value=''; document.getElementById('cliDir').value=''; document.getElementById('cliTel').value=''; document.getElementById('cliTareas').value=''; document.getElementById('cliHorario').value='';
    cargarClientes(); actualizarGraficas();
}
function cargarClientes(){
    let l=cargarLista('servdom_clientes');
    document.getElementById('listaClientes').innerHTML=l.length?l.map(c=>`<div class="tarjeta"><h3 style="color:var(--dorado);">${c.nombre}</h3><p class="fila"><span class="etiqueta">Dirección:</span><span>${c.dir}</span></p><p class="fila"><span class="etiqueta">Teléfono:</span><span>${c.tel}</span></p><p class="fila"><span class="etiqueta">Tareas:</span><span>${c.tareas}</span></p><p class="fila"><span class="etiqueta">Horarios:</span><span>${c.horario}</span></p></div>`).join(''):'<p style="text-align:center; color:var(--texto2); padding:16px;">Sin clientes registrados</p>';
}

// SERVICIOS
function agregarServicio(){
    let s={id:Date.now(), fecha:document.getElementById('servFecha').value, hora:document.getElementById('servHora').value, cliente:document.getElementById('servCliente').value, empleado:document.getElementById('servEmpleado').value, tarea:document.getElementById('servTarea').value};
    if(!s.fecha||!s.empleado) return alert('Completa fecha y empleado');
    guardarLista('servdom_servicios',s); alert('✅ Servicio asignado');
    document.getElementById('servFecha').value=''; document.getElementById('servHora').value=''; document.getElementById('servCliente').value=''; document.getElementById('servEmpleado').value=''; document.getElementById('servTarea').value='';
    cargarServicios(); cargarInicio(); actualizarGraficas();
}
function cargarServicios(){
    let l=cargarLista('servdom_servicios');
    document.getElementById('listaServicios').innerHTML=l.length?l.map(s=>`<div class="tarjeta"><p style="color:var(--dorado); font-weight:bold;">${s.fecha} — ${s.hora}</p><p class="fila"><span class="etiqueta">Empleado:</span><span>${s.empleado}</span></p><p class="fila"><span class="etiqueta">Cliente:</span><span>${s.cliente}</span></p><p class="fila"><span class="etiqueta">Tarea:</span><span>${s.tarea}</span></p></div>`).join(''):'<p style="text-align:center; color:var(--texto2); padding:16px;">Sin servicios asignados</p>';
}
function cargarInicio(){
    let l=cargarLista('servdom_servicios');
    document.getElementById('listaInicio').innerHTML=l.length?l.map(s=>`<div class="tarjeta" style="border-left:3px solid var(--dorado);"><p style="color:var(--dorado); font-weight:bold;">${s.empleado} → ${s.cliente}</p><p class="etiqueta">${s.fecha} ${s.hora} · ${s.tarea}</p></div>`).join(''):'<p style="text-align:center; color:var(--texto2); padding:16px;">Sin servicios asignados</p>';
}

// STOCK
function agregarProducto(){
    let p={id:Date.now(), nombre:document.getElementById('prodNombre').value, cant:parseInt(document.getElementById('prodCant').value), min:parseInt(document.getElementById('prodMin').value)};
    if(!p.nombre||isNaN(p.cant)) return alert('Completa los datos');
    guardarLista('servdom_stock',p); alert('✅ Producto guardado');
    document.getElementById('prodNombre').value=''; document.getElementById('prodCant').value=''; document.getElementById('prodMin').value='';
    cargarStock();
}
function cargarStock(){
    let l=cargarLista('servdom_stock');
    document.getElementById('listaProductos').innerHTML=l.length?l.map(p=>{let av=p.cant<=p.min?'<div class="alerta dorado">⚠️ ¡Pocas unidades! Reponer</div>':'';return `<div class="tarjeta"><h3 style="color:var(--dorado);">${p.nombre}</h3><p class="fila"><span class="etiqueta">Cantidad:</span><span>${p.cant}</span></p><p class="fila"><span class="etiqueta">Mínimo:</span><span>${p.min}</span></p>${av}</div>`;}).join(''):'<p style="text-align:center; color:var(--texto2); padding:16px;">Sin insumos registrados</p>';
}

// SUELDOS
function calcularSueldo(){
    let h=parseFloat(document.getElementById('liqHoras').value)||0;
    let ad=parseFloat(document.getElementById('liqAdelanto').value)||0;
    let vh=245; let br=h*vh; let bps=br*0.15; let irpf=br*0.06; let liq=br-bps-irpf-ad;
    document.getElementById('resSueldo').innerHTML=`<hr><p class="fila"><span>Bruto:</span><span>$${br.toFixed(2)}</span></p><p class="fila"><span>BPS 15%:</span><span>-$${bps.toFixed(2)}</span></p><p class="fila"><span>IRPF 6%:</span><span>-$${irpf.toFixed(2)}</span></p><p class="fila"><span>Adelantos:</span><span>-$${ad.toFixed(2)}</span></p><p class="fila" style="border-top:2px solid var(--dorado); padding-top:10px; margin-top:6px; font-weight:bold; color:var(--dorado);"><span>A cobrar:</span><span>$${liq.toFixed(2)}</span></p>`;
}

// ===== TARJETAS =====
function guardarTarjeta(){
    let t={id:Date.now(), titular:document.getElementById('tarTitular').value, numero:'**** **** **** ' + document.getElementById('tarNum').value.slice(-4), venc:document.getElementById('tarVenc').value, tipo:document.getElementById('tarTipo').value};
    if(!t.titular||!t.venc) return alert('Completa los datos');
    guardarLista('servdom_tarjetas',t); alert('✅ Tarjeta guardada');
    document.getElementById('tarTitular').value=''; document.getElementById('tarNum').value=''; document.getElementById('tarVenc').value='';
    cargarTarjetas(); cargarTarjetasSelect();
}
function cargarTarjetas(){
    let l=cargarLista('servdom_tarjetas');
    document.getElementById('listaTarjetas').innerHTML=l.length?l.map(t=>`<div class="tarjeta"><p style="color:var(--dorado); font-weight:bold;">${t.tipo==='credito'?'💳 Tarjeta de Crédito':'🏦 Tarjeta de Débito'}</p><p style="font-size:20px; letter-spacing:2px; margin:12px 0;">${t.numero}</p><p>${t.titular}</p><p class="etiqueta">Vence: ${t.venc}</p></div>`).join(''):'<p style="text-align:center; color:var(--texto2); padding:16px;">Sin tarjetas guardadas</p>';
}
function cargarTarjetasSelect(){
    let l=cargarLista('servdom_tarjetas'); let sel=document.getElementById('pagoTarjeta'); sel.innerHTML='<option value="">Seleccionar tarjeta</option>';
    l.forEach(t=>{let o=document.createElement('option'); o.value=t.id; o.textContent=t.numero+' - '+t.titular; sel.appendChild(o);});
}

// ===== CONTACTOS FRECUENTES =====
function guardarContacto(){
    let n=document.getElementById('contactoNombre').value.trim();
    let d=document.getElementById('contactoDato').value.trim();
    if(!n||!d) return alert('Escribe nombre y datos del contacto');
    guardarLista('servdom_contactos',{id:Date.now(), nombre:n, dato:d}); alert('✅ Contacto guardado');
    document.getElementById('contactoNombre').value=''; document.getElementById('contactoDato').value='';
    cargarContactos(); cargarContactosSelect();
}
function cargarContactos(){
    let l=cargarLista('servdom_contactos');
    document.getElementById('listaContactos').innerHTML=l.length?l.map(c=>`<div class="fila"><div><strong style="color:var(--dorado);">${c.nombre}</strong><br><span class="etiqueta">${c.dato}</span></div><button class="btn" style="width:auto; padding:8px 10px; font-size:13px; margin:0;" onclick="document.getElementById('pagoDestino').value='${c.dato}'">Usar</button></div>`).join(''):'<p style="text-align:center; color:var(--texto2); padding:16px;">Sin contactos guardados</p>';
}
function cargarContactosSelect(){
    let l=cargarLista('servdom_contactos'); let sel=document.getElementById('pagoContacto'); sel.innerHTML='<option value="">Seleccionar contacto</option>';
    l.forEach(c=>{let o=document.createElement('option'); o.value=c.id; o.textContent=c.nombre; sel.appendChild(o);});
}
function cargarContacto(){let id=document.getElementById('pagoContacto').value; if(!id)return; let c=cargarLista('servdom_contactos').find(x=>x.id==id); if(c)document.getElementById('pagoDestino').value=c.dato;}

// ===== REALIZAR TRANSFERENCIA =====
function realizarPago(){
    let destino=document.getElementById('pagoDestino').value.trim();
    let monto=parseFloat(document.getElementById('pagoMonto').value);
    let concepto=document.getElementById('pagoConcepto').value;
    let fecha=document.getElementById('pagoFecha').value||new Date().toISOString().slice(0,10);
    let agendar=document.getElementById('pagoAgendar').checked;
    if(!destino||!monto||monto<=0) return alert('Completa destino y monto válido');

    let pago={
        id:Date.now(),
        tipo:'pagado',
        destino:destino,
        monto:monto,
        concepto:concepto,
        fecha:fecha,
        estado:agendar?'⏳ Pendiente':'✅ Pagado',
        comprobante:`Comprobante #${Date.now()}\nFecha: ${fecha}\nDestino: ${destino}\nMonto: $${monto.toFixed(2)}\nConcepto: ${concepto||'Sin detalle'}`
    };
    guardarLista('servdom_pagos',pago);
    alert(agendar?`📅 Pago agendado para el ${fecha}`:'✅ Transferencia registrada correctamente');

    document.getElementById('pagoDestino').value='';
    document.getElementById('pagoMonto').value='';
    document.getElementById('pagoConcepto').value='';
    document.getElementById('pagoFecha').value='';
    document.getElementById('pagoAgendar').checked=false;

    cargarPagos(); calcularTotalesPagos();
}

// ===== COMPARTIR COMPROBANTE POR WHATSAPP =====
function compartirComprobante(texto){
    let mensaje=`*COMPROBANTE DE TRANSFERENCIA*\n\n${texto}`;
    window.open(`https://wa.me/?text=${encodeURIComponent(mensaje)}`,'_blank');
}

// ===== RECIBIR PAGOS - COPIAR Y COMPARTIR DATOS =====
function copiarDatos(){
    let t=document.getElementById('datosRecibir').value.trim();
    if(!t) return alert('Escribe tus datos primero (CBU, Alias, etc.)');
    navigator.clipboard.writeText(t).then(()=>alert('✅ ¡Datos copiados!'));
}
function compartirPorWhatsApp(){
    let t=document.getElementById('datosRecibir').value.trim();
    if(!t) return alert('Escribe tus datos primero (CBU, Alias, etc.)');
    let mensaje=`*Mis datos para transferencia:*\n\n${t}`;
    window.open(`https://wa.me/?text=${encodeURIComponent(mensaje)}`,'_blank');
}

// ===== HISTORIAL Y TOTALES =====
function calcularTotalesPagos(){
    let pagos=cargarLista('servdom_pagos');
    let saliente=pagos.filter(x=>x.tipo==='pagado'&&x.estado==='✅ Pagado').reduce((s,x)=>s+x.monto,0);
    let entrante=pagos.filter(x=>x.tipo==='recibido'&&x.estado==='✅ Pagado').reduce((s,x)=>s+x.monto,0);
    document.getElementById('totalSaliente').textContent='$'+saliente.toFixed(2);
    document.getElementById('totalEntrante').textContent='$'+entrante.toFixed(2);
    document.getElementById('saldoNeto').textContent='$'+(entrante-saliente).toFixed(2);
}
function cargarPagos(){
    let l=cargarLista('servdom_pagos').sort((a,b)=>b.id-a.id);
    document.getElementById('listaPagos').innerHTML=l.length?l.map(p=>`<div class="fila"><div><p style="font-weight:500; color:var(--dorado);">${p.destino||'Entrada de dinero'}</p><p class="etiqueta">${p.fecha} · ${p.concepto||'Sin detalle'} · ${p.estado}</p></div><div style="color:${p.tipo==='recibido'?'var(--verde)':'var(--rojo)'}">${p.tipo==='recibido'?'+':'-´}$${p.monto.toFixed(2)}</div></div><button class="btn wsp" style="width:100%; padding:8px; font-size:13px; margin:4px 0 12px 0;" onclick="compartirComprobante(\`${p.comprobante||'Sin comprobante'}\`)">📤 Compartir comprobante por WhatsApp</button>`).join(''):'<p style="text-align:center; color:var(--texto2); padding:16px;">Sin movimientos registrados</p>';
}

